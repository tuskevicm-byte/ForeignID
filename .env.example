# Local development example
DATABASE_URL=postgresql://foreignid:foreignid@localhost:5432/foreignid
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
FILE_STORAGE_PATH=/data/foreignid-storage
# Set FILE_STORAGE_DRIVER=s3 and S3_* values in production to use private object storage.
FILE_STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Antivirus
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
